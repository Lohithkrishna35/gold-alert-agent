# Copy this file to .env for local runs. .env is ignored by git: it never leaves your laptop.
# On GitHub, put the same names in Settings > Secrets and variables > Actions instead.
# Every contact line is ONE line of JSON.

# You: gets every drop alert AND every error note. Pick ONE of these styles:
#   Telegram:         {"name": "Lohith", "channel": "telegram", "chat_id": "123456789"}
#   CallMeBot (WA):   {"name": "Lohith", "channel": "callmebot", "phone": "+91XXXXXXXXXX", "apikey": "123456"}
#   Whatabot (WA):    {"name": "Lohith", "channel": "whatabot", "phone": "+91XXXXXXXXXX", "apikey": "your-key"}
ADMIN_CONTACT={"name": "Lohith", "channel": "telegram", "chat_id": "123456789"}

# Family: gets ONLY drop alerts and morning hints. A JSON list; each person picks a channel and a language.
#   "language": "te" = Telugu, "en" = English (default). Example:
#   [{"name": "Amma", "channel": "telegram", "chat_id": "111222333", "language": "te"}]
# Leave [] until Phase 5.
FAMILY_CONTACTS=[]

# Needed only if anyone uses Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=

# AI agent (free tiers). Either one is enough; both gives a backup.
GEMINI_API_KEY=
GROQ_API_KEY=

# Global gold price for the cross-check (free account at api-ninjas.com)
API_NINJAS_KEY=
